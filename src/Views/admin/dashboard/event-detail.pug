extends ../layout

block admin_config
  - var adminPage = 'events'
  - var adminHeading = event && event.name ? event.name : 'Phân tích sự kiện'
  - var adminDescription = `${new Date(event.date).toLocaleDateString('vi-VN')} · ${event.location || 'Chưa xác định địa điểm'}`

block admin_topbar_actions
  a.btn.admin-secondary-btn(href="/admin/dashboard/events")
    i.fas.fa-arrow-left
    span Danh sách sự kiện
  button.btn.admin-primary-btn(type="button" onclick=`sendOrganizerNotification('${event._id}')`)
    i.fas.fa-paper-plane
    span Gửi cập nhật

block content
  - const detailStatus = String((event && event.status) || '').toLowerCase();
  - const detailStatusLabel = detailStatus === 'pending' ? 'Chờ duyệt' : detailStatus === 'rejected' ? 'Bị từ chối' : detailStatus === 'upcoming' ? 'Sắp diễn ra' : detailStatus === 'ongoing' ? 'Đang diễn ra' : detailStatus === 'ended' ? 'Đã kết thúc' : 'Khác';
  - const detailStats = [{ label: 'Doanh thu', value: `${Number(stats.totalRevenue || 0).toLocaleString('vi-VN')} đ`, tone: 'is-success', icon: 'fa-sack-dollar' }, { label: 'Vé đã bán', value: stats.totalSold || 0, tone: 'is-primary', icon: 'fa-ticket' }, { label: 'Vé đang giữ', value: stats.totalHeld || 0, tone: 'is-warning', icon: 'fa-clock' }, { label: 'Vé còn lại', value: stats.totalAvailable || 0, tone: 'is-info', icon: 'fa-layer-group' }, { label: 'Tỷ lệ lấp đầy', value: `${stats.fillRate || 0}%`, tone: 'is-neutral', icon: 'fa-chart-pie' }];

  if lowSalesAlert
    .admin-insight-banner.is-warning.mb-4
      i.fas.fa-triangle-exclamation
      div
        strong Cảnh báo bán vé
        p.mb-0= lowSalesAlert.message
  else
    .admin-insight-banner.is-success.mb-4
      i.fas.fa-circle-check
      div
        strong Hiệu suất ổn định
        p.mb-0 Sự kiện đang đạt tiến độ bán vé phù hợp với thời gian diễn ra hiện tại.

  .row.g-4.mb-4
    .col-xl-8
      .admin-panel.admin-hero-card
        .admin-panel__body
          .row.g-4.align-items-center
            .col-lg-4
              img.admin-detail-cover(src=event.image || '/images/placeholder.jpg' alt=event.name)
            .col-lg-8
              .d-flex.flex-wrap.gap-2.mb-3
                span.admin-status-pill(class=`is-${detailStatus}`)= detailStatusLabel
                if event.organizer
                  span.admin-status-pill.is-neutral Organizer: #{event.organizer.name || event.organizer.email}
              h2.admin-hero-card__title.mb-2= event.name
              p.admin-hero-card__text.mb-3 Kiểm soát tiến độ bán vé, cấu trúc hạng vé và lịch sử đơn hàng trong cùng một màn hình phân tích.
              .admin-detail-meta
                .admin-detail-meta__item
                  span.admin-detail-meta__label Thời gian
                  strong= new Date(event.date).toLocaleString('vi-VN')
                .admin-detail-meta__item
                  span.admin-detail-meta__label Địa điểm
                  strong= event.location || 'Chưa xác định'
                .admin-detail-meta__item
                  span.admin-detail-meta__label Nhà tổ chức
                  strong= event.organizer && event.organizer.name ? event.organizer.name : 'Không rõ'
                .admin-detail-meta__item
                  span.admin-detail-meta__label Email liên hệ
                  strong= event.organizer && event.organizer.email ? event.organizer.email : 'Không rõ'
    .col-xl-4
      .admin-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Tình trạng đơn hàng
              p Theo dõi các nhóm đơn phát sinh cho sự kiện này.
          .admin-list-summary
            .admin-list-summary__row
              span Đã thanh toán
              strong.text-success= stats.paidOrdersCount || 0
            .admin-list-summary__row
              span Chờ thanh toán
              strong.text-warning= stats.pendingOrdersCount || 0
            .admin-list-summary__row
              span Đã hủy
              strong.text-danger= stats.cancelledOrdersCount || 0
            .admin-list-summary__row
              span Hết hạn
              strong.text-muted= stats.expiredOrdersCount || 0

  .row.g-4.mb-4
    each item in detailStats
      .col-sm-6.col-xxl
        .admin-stat-card.admin-panel(class=item.tone)
          .admin-panel__body
            .admin-stat-card__head
              span.admin-stat-card__icon
                i.fas(class=item.icon)
              span.admin-stat-card__label= item.label
            h3.admin-stat-card__value= item.value
            p.admin-stat-card__hint Chỉ số theo sự kiện hiện tại

  .row.g-4.mb-4
    .col-xl-8
      .admin-panel.admin-chart-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Doanh thu và lượng vé bán 14 ngày
              p So sánh biến động doanh thu với tốc độ bán vé theo ngày.
          canvas#lineChart(height='120')
    .col-xl-4
      .admin-panel.admin-chart-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Doanh thu theo loại vé
              p Tỷ trọng doanh thu giữa các nhóm vé.
          if ticketChart && ticketChart.labels && ticketChart.labels.length
            canvas#revenueChart(height='220')
          else
            .admin-empty-state.py-5
              i.fas.fa-chart-pie
              h4 Chưa có dữ liệu loại vé
              p Dữ liệu sẽ hiển thị khi sự kiện bắt đầu phát sinh doanh số.

  .row.g-4.mb-4
    .col-xl-7
      .admin-panel.admin-chart-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Cơ cấu vé theo từng loại
              p Đã bán, còn lại và phân bổ số lượng giữa các nhóm vé.
          if ticketChart && ticketChart.labels && ticketChart.labels.length
            canvas#ticketBarChart(height='140')
          else
            .admin-empty-state.py-5
              i.fas.fa-chart-bar
              h4 Chưa có loại vé
              p Hãy kiểm tra lại cấu hình vé của sự kiện.
    .col-xl-5
      .admin-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Loại vé
              p Bảng tóm tắt hiệu quả bán từng nhóm vé.
          if ticketTypeStats && ticketTypeStats.length > 0
            .table-responsive
              table.table.admin-table.align-middle.mb-0
                thead
                  tr
                    th Loại vé
                    th Giá
                    th Đã bán
                    th Còn lại
                    th Tỷ lệ
                tbody
                  each item in ticketTypeStats
                    - const fillClass = item.fillRate >= 60 ? 'is-success' : item.fillRate >= 30 ? 'is-warning' : 'is-danger';
                    tr
                      td.fw-semibold= item.type
                      td #{Number(item.price || 0).toLocaleString('vi-VN')} đ
                      td= item.sold
                      td= item.available
                      td
                        span.admin-status-pill(class=fillClass) #{item.fillRate}%
          else
            .admin-empty-state.py-5
              i.fas.fa-ticket
              h4 Chưa có loại vé nào
              p Dữ liệu vé sẽ hiển thị khi sự kiện được cấu hình đầy đủ.

  .row.g-4
    .col-xl-6
      .admin-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Đơn hàng thanh toán gần đây
              p Các giao dịch mới nhất của sự kiện.
          if recentPaidOrders && recentPaidOrders.length > 0
            .table-responsive
              table.table.admin-table.align-middle.mb-0
                thead
                  tr
                    th Mã đơn
                    th Tổng tiền
                    th Ngày
                tbody
                  each order in recentPaidOrders
                    tr
                      td.font-monospace= order._id
                      td.text-success.fw-semibold #{Number(order.totalAmount || 0).toLocaleString('vi-VN')} đ
                      td= new Date(order.createdAt).toLocaleString('vi-VN')
          else
            .admin-empty-state.py-5
              i.fas.fa-receipt
              h4 Chưa có đơn đã thanh toán
              p Đơn hàng thanh toán của sự kiện sẽ xuất hiện ở đây.
    .col-xl-6
      .admin-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Lịch sử thông báo cho organizer
              p Theo dõi các cảnh báo và cập nhật đã gửi.
          if recentNotifications && recentNotifications.length > 0
            .admin-timeline
              each item in recentNotifications
                .admin-timeline__item(class=item.type === 'low_sales_warning' ? 'is-warning' : 'is-info')
                  .admin-timeline__dot
                  .admin-timeline__content
                    .d-flex.justify-content-between.align-items-start.gap-3.flex-wrap
                      strong= item.title
                      span.admin-status-pill(class=item.type === 'low_sales_warning' ? 'is-danger' : 'is-primary')= item.type === 'low_sales_warning' ? 'Cảnh báo' : 'Cập nhật'
                    p.mb-1.small= item.message
                    small.text-muted= new Date(item.createdAt).toLocaleString('vi-VN')
          else
            .admin-empty-state.py-5
              i.fas.fa-bell-slash
              h4 Chưa có thông báo nào
              p Khi admin gửi cảnh báo hoặc cập nhật, lịch sử sẽ xuất hiện tại đây.

block append scripts
  script(src='https://cdn.jsdelivr.net/npm/chart.js')
  script.
    const lineLabels = !{JSON.stringify(lineChart && lineChart.labels || [])};
    const lineRevenue = !{JSON.stringify(lineChart && lineChart.revenue || [])};
    const lineTickets = !{JSON.stringify(lineChart && lineChart.tickets || [])};
    const ticketLabels = !{JSON.stringify(ticketChart && ticketChart.labels || [])};
    const ticketSold = !{JSON.stringify(ticketChart && ticketChart.sold || [])};
    const ticketRemaining = !{JSON.stringify(ticketChart && ticketChart.remaining || [])};
    const ticketRevenue = !{JSON.stringify(ticketChart && ticketChart.revenue || [])};

    const lineCanvas = document.getElementById('lineChart');
    if (lineCanvas && lineLabels.length) {
      new Chart(lineCanvas, {
        type: 'line',
        data: {
          labels: lineLabels,
          datasets: [
            {
              label: 'Doanh thu',
              data: lineRevenue,
              borderColor: '#2563eb',
              backgroundColor: 'rgba(37, 99, 235, 0.14)',
              tension: 0.35,
              fill: true,
              yAxisID: 'y'
            },
            {
              label: 'Vé bán',
              data: lineTickets,
              borderColor: '#0f9f77',
              backgroundColor: 'rgba(15, 159, 119, 0.12)',
              tension: 0.35,
              fill: true,
              yAxisID: 'y1'
            }
          ]
        },
        options: {
          responsive: true,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: {
              position: 'bottom',
              labels: { usePointStyle: true, boxWidth: 10 }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: '#64748b' }
            },
            y: {
              beginAtZero: true,
              position: 'left',
              ticks: { color: '#64748b' }
            },
            y1: {
              beginAtZero: true,
              position: 'right',
              grid: { drawOnChartArea: false },
              ticks: { color: '#64748b' }
            }
          }
        }
      });
    }

    const revenueCanvas = document.getElementById('revenueChart');
    if (revenueCanvas && ticketLabels.length) {
      new Chart(revenueCanvas, {
        type: 'doughnut',
        data: {
          labels: ticketLabels,
          datasets: [{
            data: ticketRevenue,
            backgroundColor: ['#2563eb', '#0f9f77', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4'],
            borderWidth: 2,
            borderColor: '#fff'
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { usePointStyle: true, boxWidth: 12 }
            }
          }
        }
      });
    }

    const ticketBarCanvas = document.getElementById('ticketBarChart');
    if (ticketBarCanvas && ticketLabels.length) {
      new Chart(ticketBarCanvas, {
        type: 'bar',
        data: {
          labels: ticketLabels,
          datasets: [
            {
              label: 'Đã bán',
              data: ticketSold,
              backgroundColor: '#0f9f77'
            },
            {
              label: 'Còn lại',
              data: ticketRemaining,
              backgroundColor: '#cbd5e1'
            }
          ]
        },
        options: {
          responsive: true,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { usePointStyle: true, boxWidth: 10 }
            }
          },
          scales: {
            x: { grid: { display: false }, ticks: { color: '#64748b' } },
            y: { beginAtZero: true, ticks: { color: '#64748b' } }
          }
        }
      });
    }

    async function sendOrganizerNotification(eventId) {
      if (!confirm('Gửi cập nhật doanh số và cảnh báo hiện tại cho nhà tổ chức?')) return;

      try {
        const res = await fetch(`/admin/events/${eventId}/notify-organizer`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message || 'Đã gửi thông báo');
          location.reload();
        } else {
          alert(data.message || 'Không thể gửi thông báo');
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    }
