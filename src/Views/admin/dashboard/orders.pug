extends ../layout

block admin_config
  - var adminPage = 'orders'
  - var adminHeading = 'Quản lý đơn hàng'
  - var adminDescription = 'Theo dõi trạng thái thanh toán, tìm kiếm đơn nhanh và rà soát luồng giao dịch toàn hệ thống.'

block admin_topbar_actions
  a.btn.admin-secondary-btn(href="/admin/dashboard")
    i.fas.fa-chart-line
    span Tổng quan

block content
  - const orderStats = [{ label: 'Thành công', value: stats.paidCount || 0, tone: 'is-success', icon: 'fa-circle-check' }, { label: 'Chờ duyệt', value: stats.processingCount || 0, tone: 'is-info', icon: 'fa-hourglass-half' }, { label: 'Chờ thanh toán', value: stats.pendingCount || 0, tone: 'is-warning', icon: 'fa-clock' }, { label: 'Đã hủy', value: stats.cancelledCount || 0, tone: 'is-danger', icon: 'fa-ban' }];

  if errorMessage
    .alert.alert-danger.admin-inline-alert= errorMessage

  .row.g-4.mb-4
    each item in orderStats
      .col-sm-6.col-xl-3
        .admin-stat-card.admin-panel(class=item.tone)
          .admin-panel__body
            .admin-stat-card__head
              span.admin-stat-card__icon
                i.fas(class=item.icon)
              span.admin-stat-card__label= item.label
            h3.admin-stat-card__value= item.value
            p.admin-stat-card__hint Tình trạng đơn hàng hiện tại

  .admin-panel.mb-4
    .admin-panel__body
      form.row.g-3.align-items-end(method="GET" action="/admin/dashboard/orders")
        .col-lg-6
          label.admin-field-label(for="orderQuery") Tìm kiếm đơn hàng
          .admin-input-group
            i.fas.fa-search
            input#orderQuery.form-control.admin-input(type="text" name="q" placeholder="Mã đơn, tên khách, email hoặc sự kiện..." value=filters.q)
        .col-sm-6.col-lg-3
          label.admin-field-label(for="orderStatus") Trạng thái
          select#orderStatus.form-select.admin-select(name="status")
            option(value="") Tất cả trạng thái
            option(value="PAID" selected=filters.status==='PAID') Thành công
            option(value="PROCESSING" selected=filters.status==='PROCESSING') Chờ duyệt
            option(value="PENDING" selected=filters.status==='PENDING') Chờ thanh toán
            option(value="CANCELLED" selected=filters.status==='CANCELLED') Đã hủy
        .col-sm-6.col-lg-3
          .d-flex.gap-2
            button.btn.admin-primary-btn.w-100(type="submit")
              i.fas.fa-sliders
              span Lọc
            a.btn.admin-secondary-btn(href="/admin/dashboard/orders")
              i.fas.fa-rotate-left

  .admin-panel
    .admin-panel__body
      .admin-section-heading
        div
          h3 Danh sách đơn hàng
          p Bảng dữ liệu được nén gọn hơn để quét trạng thái thanh toán và tổng tiền nhanh.
      if orders && orders.length > 0
        .table-responsive
          table.table.admin-table.align-middle.mb-0
            thead
              tr
                th Mã đơn
                th Khách hàng
                th Sự kiện
                th Vé
                th Tổng tiền
                th Trạng thái
                th Thanh toán
                th Ngày tạo
            tbody
              each o in orders
                - const orderStatus = String(o.status || '').toUpperCase();
                - const orderStatusLabel = orderStatus === 'PAID' ? 'Thành công' : orderStatus === 'PROCESSING' ? 'Chờ duyệt' : orderStatus === 'PENDING' ? 'Chờ thanh toán' : orderStatus === 'CANCELLED' ? 'Đã hủy' : orderStatus === 'EXPIRED' ? 'Hết hạn' : orderStatus === 'REFUNDED' ? 'Đã hoàn tiền' : orderStatus;
                - const orderStatusClass = orderStatus === 'PAID' ? 'is-paid' : orderStatus === 'PROCESSING' ? 'is-info' : orderStatus === 'PENDING' ? 'is-pending' : orderStatus === 'CANCELLED' ? 'is-cancelled' : orderStatus === 'REFUNDED' ? 'is-refunded' : 'is-ended';
                tr
                  td
                    strong.font-monospace= o._id
                  td
                    strong.d-block= (o.user && o.user.name) || 'Ẩn danh'
                    small.text-muted= (o.user && o.user.email) || 'Không có email'
                  td
                    strong.d-block= (o.event && o.event.name) || 'N/A'
                  td= o.totalItems || 0
                  td.text-success.fw-semibold #{Number(o.totalAmount || 0).toLocaleString('vi-VN')} đ
                  td
                    span.admin-status-pill(class=orderStatusClass)= orderStatusLabel
                  td= (o.paymentMethod || 'N/A').toUpperCase()
                  td= new Date(o.createdAt).toLocaleString('vi-VN')
                  td
                    if orderStatus === 'PROCESSING'
                      button.btn.btn-sm.btn-success.w-100.mb-1.approve-order-btn(data-order-id=o._id)
                        i.fas.fa-check
                        span Duyệt & cấp vé
      else
        .admin-empty-state
          i.fas.fa-receipt
          h4 Không có đơn hàng phù hợp
          p Điều chỉnh bộ lọc để xem thêm dữ liệu thanh toán.

  if pagination && pagination.totalPages > 1
    nav.mt-4(aria-label="Phân trang đơn hàng")
      ul.pagination.admin-pagination
        - const baseQuery = `?q=${encodeURIComponent(filters.q || '')}&status=${encodeURIComponent(filters.status || '')}&page=`;
        li.page-item(class=pagination.page <= 1 ? 'disabled' : '')
          a.page-link(href=`/admin/dashboard/orders${baseQuery}${pagination.page - 1}`) Trước
        each i in Array.from({ length: pagination.totalPages }, (_, idx) => idx + 1)
          li.page-item(class=i === pagination.page ? 'active' : '')
            a.page-link(href=`/admin/dashboard/orders${baseQuery}${i}`)= i
        li.page-item(class=pagination.page >= pagination.totalPages ? 'disabled' : '')
          a.page-link(href=`/admin/dashboard/orders${baseQuery}${pagination.page + 1}`) Sau
