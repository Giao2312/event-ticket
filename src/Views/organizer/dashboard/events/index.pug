extends ../../layout

block organizer_config
  - var organizerPage = 'events'
  - var organizerHeading = 'Sự kiện của tôi'
  - var organizerDescription = 'Theo dõi danh mục sự kiện theo trạng thái, tìm kiếm nhanh và kiểm tra mức bán vé hiện tại.'
  - var organizerSearchValue = filters && filters.q ? filters.q : ''

block organizer_topbar_actions
  a.btn.admin-secondary-btn(href="/organizer/dashboard")
    i.fas.fa-chart-line
    span Tổng quan
  a.btn.admin-primary-btn(href="/organizer/create-event")
    i.fas.fa-plus
    span Tạo sự kiện

block content
  - const eventCounters = [{ label: 'Chờ duyệt', value: counts && counts.pending || 0, status: 'pending' }, { label: 'Bị từ chối', value: counts && counts.rejected || 0, status: 'rejected' }, { label: 'Sắp diễn ra', value: counts && counts.upcoming || 0, status: 'upcoming' }, { label: 'Đang diễn ra', value: counts && counts.ongoing || 0, status: 'ongoing' }, { label: 'Đã kết thúc', value: counts && counts.ended || 0, status: 'ended' }];
  - const buildFilterLink = (status) => { const params = []; if (filters && filters.q) params.push(`q=${encodeURIComponent(filters.q)}`); if (status) params.push(`status=${encodeURIComponent(status)}`); return `/organizer/events${params.length ? `?${params.join('&')}` : ''}`; };

  if created
    .alert.alert-success.admin-inline-alert
      strong Đã gửi sự kiện thành công.
      |  Sự kiện mới của bạn đang ở trạng thái chờ admin duyệt.

  if notifications && notifications.length > 0
    .admin-panel.mb-4
      .admin-panel__body
        .admin-section-heading
          div
            h3 Thông báo gần đây
            p Cập nhật hệ thống, cảnh báo doanh số và phản hồi từ admin.
        .admin-timeline
          each item in notifications
            .admin-timeline__item(class=item.type === 'low_sales_warning' ? 'is-warning' : 'is-info')
              .admin-timeline__dot
              .admin-timeline__content
                .d-flex.justify-content-between.align-items-start.gap-3.flex-wrap
                  strong= item.title
                  span.admin-status-pill(class=item.type === 'low_sales_warning' ? 'is-danger' : 'is-primary')= item.type === 'low_sales_warning' ? 'Cảnh báo' : 'Cập nhật'
                p.mb-1.small= item.message
                if item.eventId && item.eventId.name
                  small.text-muted Sự kiện: #{item.eventId.name}

  .row.g-4.mb-4
    each item in eventCounters
      .col-sm-6.col-xl
        a.admin-mini-stat.admin-panel.text-decoration-none(class=(filters && filters.status) === item.status ? 'is-active' : '' href=buildFilterLink(item.status))
          .admin-panel__body
            span.admin-mini-stat__label= item.label
            strong.admin-mini-stat__value= item.value
    .col-sm-6.col-xl
      a.admin-mini-stat.admin-panel.text-decoration-none(class=!(filters && filters.status) ? 'is-active' : '' href=buildFilterLink(''))
        .admin-panel__body
          span.admin-mini-stat__label Tất cả
          strong.admin-mini-stat__value= events && events.length ? events.length : 0

  .admin-panel.mb-4
    .admin-panel__body
      form.row.g-3.align-items-end(method="GET" action="/organizer/events")
        .col-lg-6
          label.admin-field-label(for="eventQuery") Tìm kiếm sự kiện
          .admin-input-group
            i.fas.fa-search
            input#eventQuery.form-control.admin-input(type="text" name="q" placeholder="Tên sự kiện hoặc địa điểm..." value=(filters && filters.q) || '')
        .col-sm-6.col-lg-3
          label.admin-field-label(for="eventStatus") Trạng thái
          select#eventStatus.form-select.admin-select(name="status")
            option(value="" selected=!(filters && filters.status)) Tất cả trạng thái
            option(value="pending" selected=(filters && filters.status) === 'pending') Chờ duyệt
            option(value="rejected" selected=(filters && filters.status) === 'rejected') Bị từ chối
            option(value="upcoming" selected=(filters && filters.status) === 'upcoming') Sắp diễn ra
            option(value="ongoing" selected=(filters && filters.status) === 'ongoing') Đang diễn ra
            option(value="ended" selected=(filters && filters.status) === 'ended') Đã kết thúc
        .col-sm-6.col-lg-3
          .d-flex.gap-2
            button.btn.admin-primary-btn.w-100(type="submit")
              i.fas.fa-sliders
              span Lọc
            a.btn.admin-secondary-btn(href="/organizer/events")
              i.fas.fa-rotate-left

  .admin-panel
    .admin-panel__body
      .admin-section-heading
        div
          h3 Danh sách sự kiện
          p Bảng quản lý bám theo shell admin mới nhưng tối ưu cho dữ liệu của nhà tổ chức.
      if events && events.length > 0
        .table-responsive
          table.table.admin-table.align-middle.mb-0
            thead
              tr
                th Sự kiện
                th Lịch
                th Trạng thái
                th Vé
                th.text-end Thao tác
            tbody
              each event in events
                tr
                  td
                    .admin-table-entity
                      img.admin-thumb(src=event.image || '/images/placeholder.jpg' alt=event.name)
                      .admin-table-entity__meta
                        strong= event.name
                        small= event.location || 'Chưa cập nhật địa điểm'
                        if event.rejectionReason
                          small.text-danger Lý do từ chối: #{event.rejectionReason}
                  td
                    strong.d-block= new Date(event.date).toLocaleDateString('vi-VN')
                    small.text-muted #{event.totalSold || 0}/#{event.totalTickets || 0} vé • Fill rate #{event.fillRate || 0}%
                  td
                    span.admin-status-pill(class=`is-${event.displayStatus}`)= event.displayStatus === 'pending' ? 'Chờ duyệt' : event.displayStatus === 'rejected' ? 'Bị từ chối' : event.displayStatus === 'upcoming' ? 'Sắp diễn ra' : event.displayStatus === 'ongoing' ? 'Đang diễn ra' : 'Đã kết thúc'
                  td
                    strong= event.totalSold || 0
                    small.text-muted / #{event.totalTickets || 0}
                  td.text-end
                    .admin-action-group
                      a.btn.admin-table-btn(href=`/events/${event._id}`)
                        i.fas.fa-eye
                        span Xem công khai
                      button.btn.admin-table-btn(type="button" data-copy-event-id=event._id)
                        i.fas.fa-copy
                        span Sao chép ID
      else
        .admin-empty-state
          i.fas.fa-calendar-xmark
          h4 Chưa có sự kiện phù hợp
          p Hãy tạo thêm sự kiện mới hoặc đổi bộ lọc để hiển thị dữ liệu.
          a.btn.admin-primary-btn.mt-2(href="/organizer/create-event")
            i.fas.fa-plus
            span Tạo sự kiện

block append scripts
  script.
    document.querySelectorAll('[data-copy-event-id]').forEach((button) => {
      button.addEventListener('click', async () => {
        const eventId = button.getAttribute('data-copy-event-id');

        try {
          await navigator.clipboard.writeText(eventId);
          button.classList.add('is-success');
          const textNode = button.querySelector('span');
          if (textNode) textNode.textContent = 'Đã sao chép';
          setTimeout(() => {
            button.classList.remove('is-success');
            if (textNode) textNode.textContent = 'Sao chép ID';
          }, 1200);
        } catch (error) {
          alert('Không thể sao chép ID sự kiện');
        }
      });
    });
