block append scripts
  script.

    document.querySelectorAll('#mobileMenu a').forEach(link => {
      link.addEventListener('click', () => {
        const mobileMenu = document.getElementById('mobileMenu');
        const bsCollapse = bootstrap.Collapse.getInstance(mobileMenu);
        if (bsCollapse) bsCollapse.hide();
      });
    });

    //- Notification functions for Organizer
    async function fetchOrganizerNotifications() {
      try {
        const res = await fetch('/api/notifications/organizer');
        const data = await res.json();
        if (data.success) {
          renderNotifications(data);
        }
      } catch (err) {
        console.error('Error fetching notifications:', err);
        document.getElementById('notificationList').innerHTML = '<li class="p-3 text-center text-muted">Không thể tải thông báo</li>';
      }
    }

    function renderNotifications(data) {
      const { notifications, lowSalesEvents, unreadCount } = data;
      const notifList = document.getElementById('notificationList');
      const badge = document.getElementById('notifBadge');

      // Update badge
      if (unreadCount > 0) {
        badge.textContent = unreadCount > 9 ? '9+' : unreadCount;
        badge.style.display = 'inline-block';
      } else {
        badge.style.display = 'none';
      }

      let html = '';

      // Low sales warning section
      if (lowSalesEvents && lowSalesEvents.length > 0) {
        html += '<li class="p-2 bg-danger-subtle"><small class="fw-bold text-danger"><i class="fas fa-exclamation-triangle me-1"></i>Cảnh báo bán chậm</small></li>';
        lowSalesEvents.forEach(ev => {
          const fillColor = ev.fillRate < 15 ? 'text-danger' : 'text-warning';
          html += `
          <li class="p-2 border-bottom">
            <a href="/organizer/event/${ev.eventId}" class="text-decoration-none text-dark">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <small class="fw-bold">${ev.eventName}</small>
                  <div class="small text-muted">Đã bán: <strong class="${fillColor}">${ev.totalSold}/${ev.totalTickets}</strong> vé</div>
                  <div class="small text-muted">Còn lại: <strong>${ev.available}</strong> vé</div>
                </div>
                <span class="badge bg-danger-subtle text-danger">${ev.fillRate}%</span>
              </div>
            </a>
          </li>`;
        });
      }

      // System notifications
      if (notifications && notifications.length > 0) {
        notifications.forEach(n => {
          const isUnread = !n.isRead ? 'bg-light' : '';
          const icon = n.type === 'low_sales_warning' ? 'fa-exclamation-circle text-danger' : 'fa-info-circle text-primary';
          html += `
          <li class="p-2 border-bottom ${isUnread}" onclick="markRead('${n._id}')" style="cursor: pointer;">
            <div class="d-flex gap-2">
              <i class="fas ${icon} mt-1"></i>
              <div>
                <small class="fw-bold">${n.title}</small>
                <p class="mb-1 small text-muted">${n.message}</p>
                ${n.eventName ? `<small class="text-primary">Sự kiện: ${n.eventName}</small>` : ''}
                <div class="small text-muted">${formatTimeAgo(n.createdAt)}</div>
              </div>
            </div>
          </li>`;
        });
      }

      if (!html) {
        html = '<li class="p-3 text-center text-muted">Không có thông báo nào</li>';
      }

      notifList.innerHTML = html;
    }

    function formatTimeAgo(date) {
      const now = new Date();
      const past = new Date(date);
      const diff = Math.floor((now - past) / 1000);
      if (diff < 60) return 'Vừa xong';
      if (diff < 3600) return `${Math.floor(diff / 60)} phút trước`;
      if (diff < 86400) return `${Math.floor(diff / 3600)} giờ trước`;
      return past.toLocaleDateString('vi-VN');
    }

    async function markRead(id) {
      try {
        await fetch(`/api/notifications/mark-read/${id}`, { method: 'PUT' });
        fetchOrganizerNotifications();
      } catch (err) {
        console.error('Error marking notification as read:', err);
      }
    }

    async function markAllRead(e) {
      e.preventDefault();
      try {
        await fetch('/api/notifications/mark-all-read', { method: 'PUT' });
        fetchOrganizerNotifications();
      } catch (err) {
        console.error('Error marking all as read:', err);
      }
    }

    // Fetch notifications when page loads (for organizer)
    document.addEventListener('DOMContentLoaded', function() {
      const userRole = document.body.dataset.userRole;
      if (userRole === 'organizer') {
        fetchOrganizerNotifications();
        // Refresh every 60 seconds
        setInterval(fetchOrganizerNotifications, 60000);
      }
    });

    const handleLogout = async () => {
      const { isConfirmed } = await Swal.fire({
        title: 'Bạn muốn đăng xuất?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Đăng xuất',
        cancelButtonText: 'Hủy'
      });

      if (!isConfirmed) return;

      Swal.fire({ title: 'Đang xử lý...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

      try {
        const response = await fetch('/api/auth/logout', { method: 'POST' });
        const result = await response.json();
        if (result.success) {
          window.location.href = '/';
        } else {
          throw new Error(result.message);
        }
      } catch (error) {
        Swal.fire({ icon: 'error', title: 'Lỗi', text: error.message });
      }
    };
