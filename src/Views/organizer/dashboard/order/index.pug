extends ../../layout

block organizer_config
  - var organizerPage = 'orders'
  - var organizerHeading = 'Quản lý đơn hàng'
  - var organizerDescription = 'Theo dõi giao dịch của các sự kiện bạn đang tổ chức theo cùng shell quản trị mới.'

block organizer_topbar_actions
  a.btn.admin-secondary-btn(href="/organizer/dashboard")
    i.fas.fa-chart-line
    span Tổng quan
  a.btn.admin-primary-btn(href="/organizer/create-event")
    i.fas.fa-plus
    span Tạo sự kiện

block content
  - const orderStats = [{ label: 'Tổng đơn hàng', value: (stats && stats.totalOrders) || 0, tone: 'is-neutral', icon: 'fa-receipt', hint: 'Toàn bộ giao dịch của bạn' }, { label: 'Đã thanh toán', value: (stats && stats.paidOrders) || 0, tone: 'is-success', icon: 'fa-circle-check', hint: 'Đơn hàng đã trả tiền' }, { label: 'Chờ thanh toán', value: (stats && stats.pendingOrders) || 0, tone: 'is-warning', icon: 'fa-clock', hint: 'Đơn đang chờ xử lý' }, { label: 'Doanh thu đã thu', value: `${Number((stats && stats.totalRevenue) || 0).toLocaleString('vi-VN')} đ`, tone: 'is-primary', icon: 'fa-sack-dollar', hint: 'Cộng dồn từ đơn PAID' }];

  .row.g-4.mb-4
    each item in orderStats
      .col-sm-6.col-xl-3
        .admin-stat-card.admin-panel(class=item.tone)
          .admin-panel__body
            .admin-stat-card__head
              span.admin-stat-card__icon
                i.fas(class=item.icon)
              span.admin-stat-card__label= item.label
            h3.admin-stat-card__value= item.value
            p.admin-stat-card__hint= item.hint

  .admin-panel.mb-4
    .admin-panel__body
      .row.align-items-center.g-4
        .col-lg-8
          .d-flex.flex-wrap.gap-2
            a.admin-filter-chip(class=!statusFilter || statusFilter === 'all' ? 'is-active' : '' href="/organizer/orders") Tất cả
            a.admin-filter-chip(class=statusFilter === 'pending' ? 'is-active' : '' href="/organizer/orders?status=pending") Chờ thanh toán
            a.admin-filter-chip(class=statusFilter === 'paid' ? 'is-active' : '' href="/organizer/orders?status=paid") Đã thanh toán
            a.admin-filter-chip(class=statusFilter === 'cancelled' ? 'is-active' : '' href="/organizer/orders?status=cancelled") Đã hủy
            a.admin-filter-chip(class=statusFilter === 'refunded' ? 'is-active' : '' href="/organizer/orders?status=refunded") Hoàn tiền
        .col-lg-4
          .admin-input-group
            i.fas.fa-search
            input#searchOrder.form-control.admin-input(type="text" placeholder="Tìm theo mã đơn, khách hàng, sự kiện...")

  .admin-panel
    .admin-panel__body
      .admin-section-heading
        div
          h3 Danh sách đơn hàng
          p Kiểm tra nhanh trạng thái thanh toán và sự kiện liên quan.
      if orders && orders.length > 0
        .table-responsive
          table.table.admin-table.align-middle.mb-0
            thead
              tr
                th Mã đơn
                th Khách hàng
                th Sự kiện
                th Tổng tiền
                th Trạng thái
                th Ngày tạo
                th.text-end Xem
            tbody
              each order in orders
                - const orderStatus = String(order.status || '').toUpperCase();
                - const orderStatusLabel = orderStatus === 'PAID' ? 'Đã thanh toán' : orderStatus === 'PENDING' ? 'Chờ xử lý' : orderStatus === 'CANCELLED' ? 'Đã hủy' : orderStatus === 'REFUNDED' ? 'Hoàn tiền' : orderStatus === 'EXPIRED' ? 'Hết hạn' : orderStatus;
                - const orderStatusClass = orderStatus === 'PAID' ? 'is-success' : orderStatus === 'PENDING' ? 'is-warning' : orderStatus === 'CANCELLED' ? 'is-danger' : orderStatus === 'REFUNDED' ? 'is-info' : 'is-neutral';
                tr
                  td.font-monospace ##{String(order._id).slice(-8)}
                  td
                    .admin-user-cell
                      .admin-user-cell__avatar
                        if order.userId && order.userId.avatar
                          img.rounded-circle.w-100.h-100(src=order.userId.avatar alt=(order.userId.name || 'Avatar') style="object-fit: cover;")
                        else
                          = ((order.userId && order.userId.name) || 'K').trim().charAt(0).toUpperCase()
                      .admin-user-cell__meta
                        strong= order.userId && order.userId.name ? order.userId.name : 'Khách vãng lai'
                        small= order.eventId && order.eventId.name ? order.eventId.name : 'Sự kiện không xác định'
                  td= order.eventId && order.eventId.name ? order.eventId.name : 'Sự kiện không xác định'
                  td.text-success.fw-semibold #{Number(order.totalAmount || 0).toLocaleString('vi-VN')} đ
                  td
                    span.admin-status-pill(class=orderStatusClass)= orderStatusLabel
                  td.text-muted.small= new Date(order.createdAt).toLocaleString('vi-VN')
                  td.text-end
                    if order.eventId && order.eventId._id
                      a.btn.admin-table-btn(href=`/events/${order.eventId._id}`)
                        i.fas.fa-eye
                        span Xem sự kiện
      else
        .admin-empty-state
          i.fas.fa-shopping-cart
          h4 Chưa có đơn hàng nào
          p Hãy kiểm tra lại bộ lọc hoặc bắt đầu mở bán để nhận những giao dịch đầu tiên.

  if totalPages > 1
    nav.mt-4(aria-label="Phân trang đơn hàng organizer")
      ul.pagination.admin-pagination.justify-content-center
        li.page-item(class=(currentPage === 1 ? 'disabled' : ''))
          a.page-link(href=`/organizer/orders?page=${currentPage - 1}&status=${statusFilter || 'all'}`) Trước
        - for (let i = 1; i <= totalPages; i++)
          li.page-item(class=(i === currentPage ? 'active' : ''))
            a.page-link(href=`/organizer/orders?page=${i}&status=${statusFilter || 'all'}`)= i
        li.page-item(class=(currentPage === totalPages ? 'disabled' : ''))
          a.page-link(href=`/organizer/orders?page=${currentPage + 1}&status=${statusFilter || 'all'}`) Sau

block append scripts
  script.
    document.getElementById('searchOrder')?.addEventListener('keyup', function() {
      const filter = this.value.toLowerCase();
      document.querySelectorAll('tbody tr').forEach((row) => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(filter) ? '' : 'none';
      });
    });
