block admin_config
- const currentAdminPage = typeof adminPage !== 'undefined' ? adminPage : 'dashboard';
- const currentAdminHeading = typeof adminHeading !== 'undefined' ? adminHeading : (pageTitle || 'Bảng điều khiển quản trị');
- const currentAdminDescription = typeof adminDescription !== 'undefined' ? adminDescription : 'Theo dõi vận hành hệ thống sự kiện trên một giao diện thống nhất.';
- const adminSearchText = typeof adminSearchValue !== 'undefined' ? adminSearchValue : '';
- const adminUserName = user && user.name ? user.name : 'Admin';
- const adminUserInitial = adminUserName.trim().charAt(0).toUpperCase();
doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= pageTitle || 'EventVé Admin'
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet")
    link(rel="stylesheet", href="/css/style.css")
  body.admin-body(data-user-role=(user && user.role) ? user.role.toLowerCase() : '')
    .admin-shell
      aside.admin-sidebar
        .admin-sidebar__header
          a.admin-brand(href="/admin/dashboard")
            span.admin-brand__icon
              i.fas.fa-ticket-alt
            span
              strong EventVé
              small Admin console
          p.admin-sidebar__caption Điều phối sự kiện, người dùng và đơn hàng trong một không gian quản trị riêng.

        nav.admin-sidebar__nav
          a.admin-nav-link(class=currentAdminPage === 'dashboard' ? 'is-active' : '' href="/admin/dashboard")
            span.admin-nav-link__icon
              i.fas.fa-chart-line
            span.admin-nav-link__text Tổng quan
          a.admin-nav-link(class=currentAdminPage === 'events' ? 'is-active' : '' href="/admin/dashboard/events")
            span.admin-nav-link__icon
              i.fas.fa-calendar-check
            span.admin-nav-link__text Sự kiện
          a.admin-nav-link(class=currentAdminPage === 'orders' ? 'is-active' : '' href="/admin/dashboard/orders")
            span.admin-nav-link__icon
              i.fas.fa-receipt
            span.admin-nav-link__text Đơn hàng
          a.admin-nav-link(class=currentAdminPage === 'users' ? 'is-active' : '' href="/admin/dashboard/users")
            span.admin-nav-link__icon
              i.fas.fa-users
            span.admin-nav-link__text Người dùng
          a.admin-nav-link(class=currentAdminPage === 'withdrawals' ? 'is-active' : '' href="/admin/dashboard/withdrawals")
            span.admin-nav-link__icon
              i.fas.fa-money-bill-transfer
            span.admin-nav-link__text Rút tiền
          a.admin-nav-link(class=currentAdminPage === 'settlements' ? 'is-active' : '' href="/admin/dashboard/settlements")
            span.admin-nav-link__icon
              i.fas.fa-file-invoice-dollar
            span.admin-nav-link__text Đối soát

        .admin-sidebar__footer
          a.admin-side-utility(href="/")
            i.fas.fa-arrow-up-right-from-square
            span Mở trang người dùng
          if user
            a.admin-side-utility(href="/profile")
              i.fas.fa-user-circle
              span Hồ sơ quản trị
          button.admin-side-utility.admin-side-utility--danger(type="button" onclick="handleAdminLogout()")
            i.fas.fa-right-from-bracket
            span Đăng xuất

      .admin-main
        header.admin-topbar
          .admin-topbar__intro
            p.admin-eyebrow Quản trị hệ thống
            h1.admin-topbar__title= currentAdminHeading
            if currentAdminDescription
              p.admin-topbar__description= currentAdminDescription

          .admin-topbar__tools
            form.admin-topbar__search(action="/admin/dashboard/events" method="GET")
              i.fas.fa-search
              input(type="search" name="q" placeholder="Tìm sự kiện để kiểm duyệt..." value=adminSearchText)

            block admin_topbar_actions

            .admin-user-card
              .admin-user-card__avatar= adminUserInitial
              .admin-user-card__meta
                strong= adminUserName
                span= user && user.role ? user.role : 'Quản trị viên'

        main.admin-page
          block content

    block scripts
      script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous")
      script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
      script(src="/js/admin.js")
      script.
        async function handleAdminLogout() {
          const result = await Swal.fire({
            title: 'Đăng xuất khỏi khu vực quản trị?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Đăng xuất',
            cancelButtonText: 'Hủy'
          });

          if (!result.isConfirmed) return;

          try {
            const response = await fetch('/api/auth/logout', { method: 'POST' });
            const data = await response.json();

            if (data.success) {
              window.location.href = '/';
              return;
            }

            throw new Error(data.message || 'Không thể đăng xuất');
          } catch (error) {
            Swal.fire({
              icon: 'error',
              title: 'Lỗi',
              text: error.message
            });
          }
        }
