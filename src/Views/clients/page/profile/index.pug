extends ../../../layout

block content
  section.profile-page.py-5.min-vh-100
    .container
      .row.justify-content-center
        .col-lg-9
          .card.app-card.shadow-sm
            .card-header.profile-head.text-center.py-5
              .profile-avatar.mx-auto
                img.w-100.h-100(src=user.avatar || '/events/images/default-avatar.jpg' alt=user.name style="object-fit: cover;")
              h2.mt-4.fw-bold.display-6 #{user.name || 'Người dùng'}
              p.mb-1.opacity-75 #{user.email}
              small.opacity-75 Đã tham gia từ #{new Date(user.createdAt).toLocaleDateString('vi-VN')}

            .card-body.p-4.p-md-5
              .row.g-4.mb-4
                .col-md-6
                  .d-flex.align-items-start.gap-3
                    i.fas.fa-envelope.fs-5.text-primary.mt-1
                    div
                      p.mb-1.profile-meta-title Email
                      p.mb-0.profile-meta-value #{user.email || 'Chưa cập nhật'}
                .col-md-6
                  .d-flex.align-items-start.gap-3
                    i.fas.fa-phone.fs-5.text-primary.mt-1
                    div
                      p.mb-1.profile-meta-title Số điện thoại
                      p.mb-0.profile-meta-value #{user.phone || 'Chưa cập nhật'}
                .col-md-6
                  .d-flex.align-items-start.gap-3
                    i.fas.fa-calendar-alt.fs-5.text-primary.mt-1
                    div
                      p.mb-1.profile-meta-title Ngày sinh
                      p.mb-0.profile-meta-value #{user.dob ? new Date(user.dob).toLocaleDateString('vi-VN') : 'Chưa cập nhật'}
                .col-md-6
                  .d-flex.align-items-start.gap-3
                    i.fas.fa-map-marker-alt.fs-5.text-primary.mt-1
                    div
                      p.mb-1.profile-meta-title Địa chỉ
                      p.mb-0.profile-meta-value #{user.address || 'Chưa cập nhật'}

              h4.fw-bold.mb-3 Chỉnh sửa thông tin
              p.app-section-subtitle.mb-4 Cập nhật hồ sơ để hệ thống gợi ý sự kiện phù hợp hơn.

              form#profileForm.needs-validation(novalidate)
                .row.g-4
                  .col-md-6
                    label.form-label.fw-semibold Họ và tên
                    input.form-control.input-brand(type="text" name="name" value=user.name placeholder="Họ và tên" required)
                  .col-md-6
                    label.form-label.fw-semibold Số điện thoại
                    input.form-control.input-brand(type="tel" name="phone" value=user.phone placeholder="Số điện thoại")
                  .col-md-6
                    label.form-label.fw-semibold Ngày sinh
                    input.form-control.input-brand(type="date" name="dob" value=user.dob ? user.dob.toISOString().split('T')[0] : '')
                  .col-md-12
                    label.form-label.fw-semibold Địa chỉ
                    input.form-control.input-brand(type="text" name="address" value=user.address placeholder="Địa chỉ chi tiết")
                  .col-md-12
                    label.form-label.fw-semibold Chọn ảnh đại diện mới
                    input.form-control.input-brand(type="file" name="avatarFile" accept="image/*")
                    input(type="hidden" name="avatar" value=user.avatar)

                .mt-4.d-flex.flex-wrap.justify-content-center.gap-2
                  button.btn.btn-brand-primary.px-5.py-2(type="submit")
                    i.fas.fa-save.me-2
                    | Cập nhật thông tin
                  a.btn.btn-brand-secondary.px-4.py-2(href="/my-tickets")
                    i.fas.fa-ticket-alt.me-2
                    | Vé của tôi

              .mt-4.text-center
                a.text-primary.fw-semibold.text-decoration-none(href="/change-password")
                  i.fas.fa-key.me-2
                  | Đổi mật khẩu

block append scripts
  script.
    document.getElementById('profileForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);

      try {
        const res = await fetch('/profile/update', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (res.ok) {
          alert('Cập nhật thông tin thành công!');
          window.location.reload();
        } else {
          alert(result.message || 'Cập nhật thất bại');
        }
      } catch (err) {
        alert('Có lỗi kết nối server');
      }
    });
