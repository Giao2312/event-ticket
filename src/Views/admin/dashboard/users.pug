extends ../layout

block admin_config
  - var adminPage = 'users'
  - var adminHeading = 'Quản lý người dùng'
  - var adminDescription = 'Theo dõi tài khoản, vai trò và trạng thái hoạt động toàn hệ thống theo bố cục bảng quản trị mới.'

block admin_topbar_actions
  a.btn.admin-secondary-btn(href="/admin/dashboard/orders")
    i.fas.fa-receipt
    span Đơn hàng

block content
  - const userStats = [{ label: 'Tổng user', value: stats.totalUsers || 0, tone: 'is-neutral', icon: 'fa-users' }, { label: 'Đang hoạt động', value: stats.activeUsers || 0, tone: 'is-success', icon: 'fa-circle-check' }, { label: 'Đã khóa', value: stats.inactiveUsers || 0, tone: 'is-danger', icon: 'fa-user-lock' }, { label: 'Admin', value: stats.adminCount || 0, tone: 'is-primary', icon: 'fa-user-shield' }, { label: 'Organizer', value: stats.organizerCount || 0, tone: 'is-warning', icon: 'fa-building' }, { label: 'User thường', value: stats.userCount || 0, tone: 'is-info', icon: 'fa-user' }];

  if errorMessage
    .alert.alert-danger.admin-inline-alert= errorMessage

  .row.g-4.mb-4
    each item in userStats
      .col-sm-6.col-xxl-4
        .admin-stat-card.admin-panel(class=item.tone)
          .admin-panel__body
            .admin-stat-card__head
              span.admin-stat-card__icon
                i.fas(class=item.icon)
              span.admin-stat-card__label= item.label
            h3.admin-stat-card__value= item.value
            p.admin-stat-card__hint Thống kê người dùng toàn hệ thống

  .admin-panel.mb-4
    .admin-panel__body
      form.row.g-3.align-items-end(method="GET" action="/admin/dashboard/users")
        .col-lg-5
          label.admin-field-label(for="userQuery") Tìm kiếm người dùng
          .admin-input-group
            i.fas.fa-search
            input#userQuery.form-control.admin-input(type="text" name="q" placeholder="Tên, email hoặc số điện thoại..." value=filters.q)
        .col-sm-6.col-lg-3
          label.admin-field-label(for="userRole") Vai trò
          select#userRole.form-select.admin-select(name="role")
            option(value="") Tất cả vai trò
            option(value="admin" selected=filters.role==='admin') Admin
            option(value="organizer" selected=filters.role==='organizer') Organizer
            option(value="user" selected=filters.role==='user') User
        .col-sm-6.col-lg-2
          label.admin-field-label(for="userStatus") Trạng thái
          select#userStatus.form-select.admin-select(name="status")
            option(value="") Tất cả trạng thái
            option(value="active" selected=filters.status==='active') Đang hoạt động
            option(value="inactive" selected=filters.status==='inactive') Đã khóa
        .col-sm-6.col-lg-2
          .d-flex.gap-2
            button.btn.admin-primary-btn.w-100(type="submit")
              i.fas.fa-sliders
              span Lọc
            a.btn.admin-secondary-btn(href="/admin/dashboard/users")
              i.fas.fa-rotate-left

  .admin-panel
    .admin-panel__body
      .admin-section-heading
        div
          h3 Danh sách người dùng
          p Hàng dữ liệu nén gọn để kiểm tra vai trò, trạng thái và thao tác khóa hoặc mở khóa nhanh.
      if users && users.length > 0
        .table-responsive
          table.table.admin-table.align-middle.mb-0
            thead
              tr
                th Người dùng
                th Điện thoại
                th Vai trò
                th Trạng thái
                th Ngày tạo
                th.text-end Thao tác
            tbody
              each u in users
                - const roleValue = String(u.role || '').toLowerCase();
                - const roleLabel = roleValue === 'admin' ? 'Admin' : roleValue === 'organizer' ? 'Organizer' : 'User';
                - const roleClass = roleValue === 'admin' ? 'is-primary' : roleValue === 'organizer' ? 'is-warning' : 'is-neutral';
                tr
                  td
                    .admin-user-cell
                      .admin-user-cell__avatar= (u.name || 'U').trim().charAt(0).toUpperCase()
                      .admin-user-cell__meta
                        strong= u.name || 'Chưa cập nhật'
                        small= u.email || 'N/A'
                  td= u.phone || 'Chưa cập nhật'
                  td
                    span.admin-status-pill(class=roleClass)= roleLabel
                  td
                    if u.isActive
                      span.admin-status-pill.is-active Đang hoạt động
                    else
                      span.admin-status-pill.is-inactive Đã khóa
                  td= new Date(u.createdAt).toLocaleString('vi-VN')
                  td.text-end
                    if user && String(user._id) === String(u._id)
                      span.text-muted.small Tài khoản hiện tại
                    else
                      button.btn.admin-table-btn(type="button" class=u.isActive ? 'is-danger' : 'is-success' onclick=`toggleUserStatus('${u._id}')`)
                        if u.isActive
                          i.fas.fa-lock
                          span Khóa
                        else
                          i.fas.fa-lock-open
                          span Mở khóa
      else
        .admin-empty-state
          i.fas.fa-users-slash
          h4 Không có người dùng phù hợp
          p Hãy điều chỉnh bộ lọc để xem thêm tài khoản trong hệ thống.

  if pagination && pagination.totalPages > 1
    nav.mt-4(aria-label="Phân trang người dùng")
      ul.pagination.admin-pagination
        - const baseQuery = `?q=${encodeURIComponent(filters.q || '')}&role=${encodeURIComponent(filters.role || '')}&status=${encodeURIComponent(filters.status || '')}&page=`;
        li.page-item(class=pagination.page <= 1 ? 'disabled' : '')
          a.page-link(href=`/admin/dashboard/users${baseQuery}${pagination.page - 1}`) Trước
        each i in Array.from({ length: pagination.totalPages }, (_, idx) => idx + 1)
          li.page-item(class=i === pagination.page ? 'active' : '')
            a.page-link(href=`/admin/dashboard/users${baseQuery}${i}`)= i
        li.page-item(class=pagination.page >= pagination.totalPages ? 'disabled' : '')
          a.page-link(href=`/admin/dashboard/users${baseQuery}${pagination.page + 1}`) Sau

block append scripts
  script.
    async function toggleUserStatus(userId) {
      const confirmed = confirm('Bạn có chắc chắn muốn thay đổi trạng thái tài khoản này?');
      if (!confirmed) return;

      try {
        const res = await fetch(`/admin/users/${userId}/toggle-status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();

        if (data.success) {
          location.reload();
        } else {
          alert(data.message || 'Không thể cập nhật trạng thái người dùng');
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    }
