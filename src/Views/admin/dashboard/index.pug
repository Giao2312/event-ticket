extends ../layout

block admin_config
  - var adminPage = 'dashboard'
  - var adminHeading = 'Bảng điều khiển quản trị'
  - var adminDescription = 'Theo dõi doanh thu, luồng bán vé và hàng chờ duyệt trên một giao diện tập trung.'

block admin_topbar_actions
  a.btn.admin-secondary-btn(href="/admin/dashboard/orders")
    i.fas.fa-receipt
    span Đơn hàng
  a.btn.admin-primary-btn(href="/admin/dashboard/events/create")
    i.fas.fa-plus
    span Tạo sự kiện

block content
  - const overviewStats = [{ label: 'Tổng doanh thu', value: `${Number((stats && stats.totalRevenue) || 0).toLocaleString('vi-VN')} đ`, hint: 'Đơn đã thanh toán', icon: 'fa-sack-dollar', tone: 'is-success' }, { label: 'Vé đã bán', value: `${(stats && stats.ticketsSold) || 0}`, hint: `${(stats && stats.ticketsSold) || 0}/${(stats && stats.totalCapacity) || 0} vé`, icon: 'fa-ticket', tone: 'is-primary' }, { label: 'Lưu lượng truy cập', value: `${(stats && stats.traffic) || 0}`, hint: 'Tổng lượt xem sự kiện', icon: 'fa-chart-column', tone: 'is-info' }, { label: 'Tỷ lệ chuyển đổi', value: `${(stats && stats.conversionRate) || 0}%`, hint: 'Đơn hàng trên traffic', icon: 'fa-bolt', tone: 'is-warning' }, { label: 'Tổng sự kiện', value: `${(stats && stats.totalEvents) || 0}`, hint: 'Toàn hệ thống', icon: 'fa-calendar-days', tone: 'is-neutral' }, { label: 'Người dùng', value: `${(stats && stats.totalUsers) || 0}`, hint: 'Tài khoản đã đăng ký', icon: 'fa-users', tone: 'is-primary' }];
  - const statusItems = [{ label: 'Chờ duyệt', value: pendingCount || 0, hint: 'Cần admin kiểm tra', icon: 'fa-hourglass-half', tone: 'is-pending' }, { label: 'Bị từ chối', value: rejectedCount || 0, hint: 'Cần theo dõi lại', icon: 'fa-ban', tone: 'is-rejected' }, { label: 'Sắp diễn ra', value: upcomingCount || 0, hint: 'Chuẩn bị mở bán', icon: 'fa-calendar-check', tone: 'is-upcoming' }, { label: 'Đang diễn ra', value: ongoingCount || 0, hint: 'Theo dõi realtime', icon: 'fa-play-circle', tone: 'is-ongoing' }, { label: 'Đã kết thúc', value: endedCount || 0, hint: 'Lưu trữ & phân tích', icon: 'fa-flag-checkered', tone: 'is-ended' }];
  - const dashboardFilters = [{ key: 'all', label: 'Tất cả' }, { key: 'pending', label: 'Chờ duyệt' }, { key: 'rejected', label: 'Bị từ chối' }, { key: 'upcoming', label: 'Sắp diễn ra' }, { key: 'ongoing', label: 'Đang diễn ra' }, { key: 'ended', label: 'Đã kết thúc' }];

  if errorMessage
    .alert.alert-danger.admin-inline-alert= errorMessage

  section.admin-hero-card.admin-panel.mb-4
    .admin-panel__body
      .row.g-4.align-items-center
        .col-xl-7
          span.admin-kicker Toàn cảnh vận hành
          h2.admin-hero-card__title Điều phối sự kiện, doanh thu và kiểm duyệt từ một nhịp giao diện thống nhất.
          p.admin-hero-card__text Khung quản trị mới giữ nguyên dữ liệu và workflow hiện có, nhưng tái tổ chức theo kiểu sidebar, topbar và thẻ sáng gọn hơn để thao tác nhanh.
          .admin-hero-card__metrics
            .admin-hero-card__metric
              strong= pendingCount || 0
              span Sự kiện chờ duyệt
            .admin-hero-card__metric
              strong #{stats && stats.fillRate || 0}%
              span Tỷ lệ lấp đầy
            .admin-hero-card__metric
              strong= recentOrders && recentOrders.length ? recentOrders.length : 0
              span Đơn gần đây
        .col-xl-5
          .admin-highlight-card
            .admin-highlight-card__head
              span.admin-kicker Nhịp độ 14 ngày
              h3 Theo dõi tăng trưởng
            p.mb-3.text-muted Admin có thể quan sát doanh thu, lượt bán và chuyển nhanh sang hàng chờ duyệt ở ngay bên dưới.
            .admin-highlight-card__stack
              .admin-highlight-card__row
                span Doanh thu hiện tại
                strong #{Number((stats && stats.totalRevenue) || 0).toLocaleString('vi-VN')} đ
              .admin-highlight-card__row
                span Vé đã bán
                strong= (stats && stats.ticketsSold) || 0
              .admin-highlight-card__row
                span Tài khoản hệ thống
                strong= (stats && stats.totalUsers) || 0

  .row.g-4.mb-4
    each item in overviewStats
      .col-sm-6.col-xxl-4
        .admin-stat-card.admin-panel(class=item.tone)
          .admin-panel__body
            .admin-stat-card__head
              span.admin-stat-card__icon
                i.fas(class=item.icon)
              span.admin-stat-card__label= item.label
            h3.admin-stat-card__value= item.value
            p.admin-stat-card__hint= item.hint

  .row.g-4.mb-4
    .col-xl-8
      .admin-panel.admin-chart-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Doanh thu và lượng vé bán
              p So sánh xu hướng doanh thu với tốc độ bán vé trong 14 ngày gần nhất.
            span.admin-section-badge Cập nhật tự động
          canvas#lineChart(height="120")
    .col-xl-4
      .admin-panel.admin-chart-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Doanh thu theo thanh toán
              p Tỷ trọng các phương thức thanh toán đang đóng góp.
          if pieChart && pieChart.labels && pieChart.labels.length
            canvas#pieChart(height="180")
          else
            .admin-empty-state.py-5
              i.fas.fa-chart-pie
              h4 Chưa có dữ liệu
              p Chưa phát sinh đơn hàng thanh toán để hiển thị tỷ trọng doanh thu.

  .row.g-4.mb-4
    .col-xl-7
      .admin-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Tình trạng sự kiện
              p Nhìn nhanh các nhóm cần xử lý hoặc theo dõi sát trong ngày.
          .admin-status-grid
            each item in statusItems
              .admin-status-tile(class=item.tone)
                .admin-status-tile__icon
                  i.fas(class=item.icon)
                strong= item.value
                span= item.label
                small= item.hint
    .col-xl-5
      .admin-panel
        .admin-panel__body
          .admin-section-heading
            div
              h3 Đơn hàng gần đây
              p Luồng thanh toán mới nhất để admin kiểm tra nhanh.
            a.admin-text-link(href="/admin/dashboard/orders") Xem tất cả
          if recentOrders && recentOrders.length > 0
            .admin-activity-list
              each order in recentOrders
                .admin-activity-item
                  .admin-activity-item__content
                    strong.font-monospace= String(order._id).slice(-8)
                    span= order.userId && order.userId.name ? order.userId.name : 'Khách vãng lai'
                    small= new Date(order.createdAt).toLocaleString('vi-VN')
                  .admin-activity-item__meta
                    strong.text-success #{Number(order.totalAmount || 0).toLocaleString('vi-VN')} đ
          else
            .admin-empty-state.py-5
              i.fas.fa-receipt
              h4 Chưa có đơn hàng gần đây
              p Dữ liệu đơn hàng mới sẽ xuất hiện tại đây.

  .admin-panel
    .admin-panel__body
      .admin-section-heading
        div
          h3 Hàng chờ duyệt và sự kiện mới cập nhật
          p Bám theo ảnh tham chiếu bằng cấu trúc bảng thoáng, nhưng vẫn giữ dữ liệu và thao tác admin hiện có.
        .admin-filter-row
          each item in dashboardFilters
            button.admin-filter-chip(type="button" class=item.key === 'all' ? 'is-active' : '' data-dashboard-filter=item.key)= item.label
      if events && events.length > 0
        .table-responsive
          table.table.admin-table.align-middle.mb-0
            thead
              tr
                th Sự kiện
                th Nhà tổ chức
                th Thời gian
                th Trạng thái
                th.text-end Xử lý
            tbody
              each event in events
                - const dashboardStatus = String(event.status || '').toLowerCase();
                - const dashboardStatusLabel = dashboardStatus === 'pending' ? 'Chờ duyệt' : dashboardStatus === 'rejected' ? 'Bị từ chối' : dashboardStatus === 'upcoming' ? 'Sắp diễn ra' : dashboardStatus === 'ongoing' ? 'Đang diễn ra' : dashboardStatus === 'ended' ? 'Đã kết thúc' : 'Khác';
                tr(data-dashboard-row data-status=dashboardStatus)
                  td
                    .admin-table-entity
                      img.admin-thumb(src=event.image || '/images/placeholder.jpg' alt=event.name)
                      .admin-table-entity__meta
                        strong= event.name
                        small= event.location || 'Chưa cập nhật địa điểm'
                        if dashboardStatus === 'rejected' && event.rejectionReason
                          small.text-danger Lý do từ chối: #{event.rejectionReason}
                  td
                    strong.d-block= event.organizer && event.organizer.name ? event.organizer.name : 'Chưa có organizer'
                    small.text-muted= event.organizer && event.organizer.email ? event.organizer.email : 'Không có email'
                  td
                    strong.d-block= new Date(event.date).toLocaleDateString('vi-VN')
                    small.text-muted Tạo lúc #{new Date(event.createdAt).toLocaleDateString('vi-VN')}
                  td
                    span.admin-status-pill(class=`is-${dashboardStatus}`)= dashboardStatusLabel
                  td.text-end
                    .admin-action-group
                      a.btn.admin-table-btn(href=`/admin/dashboard/events/${event._id}`)
                        i.fas.fa-chart-area
                        span Phân tích
                      if dashboardStatus === 'pending'
                        button.btn.admin-table-btn.is-success(type="button" onclick=`approveEvent('${event._id}')`)
                          i.fas.fa-check
                          span Duyệt
                        button.btn.admin-table-btn.is-danger(type="button" onclick=`rejectEvent('${event._id}')`)
                          i.fas.fa-xmark
                          span Từ chối
                      else if dashboardStatus === 'rejected'
                        button.btn.admin-table-btn.is-primary(type="button" onclick=`approveEvent('${event._id}')`)
                          i.fas.fa-rotate-left
                          span Duyệt lại
                        button.btn.admin-table-btn.is-danger(type="button" onclick=`deleteEvent('${event._id}')`)
                          i.fas.fa-trash
                          span Xóa
      else
        .admin-empty-state
          i.fas.fa-calendar-xmark
          h4 Chưa có sự kiện nào để hiển thị
          p Hàng chờ duyệt và sự kiện mới sẽ xuất hiện tại đây khi dữ liệu được cập nhật.

block append scripts
  script(src="https://cdn.jsdelivr.net/npm/chart.js")
  script.
    const lineLabels = !{JSON.stringify(lineChart && lineChart.labels || [])};
    const lineRevenue = !{JSON.stringify(lineChart && lineChart.revenue || [])};
    const lineTickets = !{JSON.stringify(lineChart && lineChart.tickets || [])};
    const pieLabels = !{JSON.stringify(pieChart && pieChart.labels || [])};
    const pieValues = !{JSON.stringify(pieChart && pieChart.values || [])};

    const lineCanvas = document.getElementById('lineChart');
    if (lineCanvas && lineLabels.length) {
      new Chart(lineCanvas, {
        type: 'line',
        data: {
          labels: lineLabels,
          datasets: [
            {
              label: 'Doanh thu',
              data: lineRevenue,
              borderColor: '#2563eb',
              backgroundColor: 'rgba(37, 99, 235, 0.14)',
              tension: 0.35,
              fill: true
            },
            {
              label: 'Vé bán',
              data: lineTickets,
              borderColor: '#0f9f77',
              backgroundColor: 'rgba(15, 159, 119, 0.12)',
              tension: 0.35,
              fill: true
            }
          ]
        },
        options: {
          responsive: true,
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                usePointStyle: true,
                boxWidth: 10
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { maxTicksLimit: 7, color: '#64748b' }
            },
            y: {
              beginAtZero: true,
              ticks: { color: '#64748b' }
            }
          }
        }
      });
    }

    const pieCanvas = document.getElementById('pieChart');
    if (pieCanvas && pieLabels.length) {
      new Chart(pieCanvas, {
        type: 'pie',
        data: {
          labels: pieLabels,
          datasets: [{
            data: pieValues,
            backgroundColor: ['#2563eb', '#0f9f77', '#f59e0b', '#ef4444', '#06b6d4', '#8b5cf6'],
            borderColor: '#ffffff',
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                usePointStyle: true,
                boxWidth: 12
              }
            }
          }
        }
      });
    }

    const dashboardFilters = document.querySelectorAll('[data-dashboard-filter]');
    const dashboardRows = document.querySelectorAll('[data-dashboard-row]');

    dashboardFilters.forEach((button) => {
      button.addEventListener('click', () => {
        const status = button.dataset.dashboardFilter;

        dashboardFilters.forEach((item) => item.classList.remove('is-active'));
        button.classList.add('is-active');

        dashboardRows.forEach((row) => {
          const rowStatus = row.dataset.status;
          row.style.display = status === 'all' || rowStatus === status ? '' : 'none';
        });
      });
    });

    window.approveEvent = async (id) => {
      if (!confirm('Bạn chắc chắn muốn duyệt sự kiện này?')) return;
      try {
        const res = await fetch(`/admin/events/${id}/approve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          alert(data.message || 'Lỗi khi duyệt');
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    };

    window.rejectEvent = async (id) => {
      const reason = prompt('Nhập lý do từ chối (bắt buộc):');
      if (!reason || reason.trim() === '') {
        alert('Vui lòng nhập lý do từ chối');
        return;
      }
      try {
        const res = await fetch(`/admin/events/${id}/reject`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason: reason.trim() })
        });
        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          alert(data.message || 'Lỗi khi từ chối');
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    };

    window.deleteEvent = async (id) => {
      if (!confirm('XÓA VĨNH VIỄN sự kiện này? Hành động không thể hoàn tác!')) return;
      try {
        const res = await fetch(`/admin/events/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          alert(data.message || 'Lỗi khi xóa');
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    };
