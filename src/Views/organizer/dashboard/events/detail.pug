extends ../../layout

block organizer_config
  - var organizerPage = 'events'
  - var organizerHeading = 'Bảng sự kiện theo trạng thái'
  - var organizerDescription = 'Phiên bản board giúp rà nhanh tiến độ từng nhóm sự kiện trong shell organizer mới.'

block organizer_topbar_actions
  a.btn.admin-secondary-btn(href="/organizer/events")
    i.fas.fa-table
    span Xem dạng bảng
  a.btn.admin-primary-btn(href="/organizer/create-event")
    i.fas.fa-plus
    span Tạo sự kiện

block content
  -
    const now = new Date();
    const eventsList = events || [];
    const getStatus = (ev) => {
      if (ev && ev.displayStatus) return ev.displayStatus;
      if (ev && ev.status && ['pending', 'rejected', 'upcoming', 'ongoing', 'ended'].includes(String(ev.status).toLowerCase())) return String(ev.status).toLowerCase();
      if (!ev || !ev.date) return 'upcoming';
      const d = new Date(ev.date);
      if (Number.isNaN(d.getTime())) return 'upcoming';
      if (d < now) return 'ended';
      const threshold = new Date(now.getTime() + 24 * 60 * 60 * 1000);
      return d <= threshold ? 'ongoing' : 'upcoming';
    };
    const calcTotalTickets = (ev) => ev && ev.totalTickets != null ? ev.totalTickets : (ev.ticketTypes || []).reduce((sum, t) => sum + (t.quantity || 0), 0);
    const calcSoldTickets = (ev) => ev && ev.totalSold != null ? ev.totalSold : (ev.ticketTypes || []).reduce((sum, t) => sum + (t.sold || 0), 0);
    const pendingEvents = eventsList.filter(e => getStatus(e) === 'pending');
    const rejectedEvents = eventsList.filter(e => getStatus(e) === 'rejected');
    const ongoingEvents = eventsList.filter(e => getStatus(e) === 'ongoing');
    const upcomingEvents = eventsList.filter(e => getStatus(e) === 'upcoming');
    const endedEvents = eventsList.filter(e => getStatus(e) === 'ended');

  if created
    .alert.alert-success.admin-inline-alert
      strong Đã tạo sự kiện thành công.
      |  Yêu cầu của bạn đã được gửi sang admin để chờ duyệt.

  if notifications && notifications.length > 0
    .admin-panel.mb-4
      .admin-panel__body
        .admin-section-heading
          div
            h3 Thông báo hệ thống
            p Những cập nhật mới nhất ảnh hưởng tới các sự kiện của bạn.
        .admin-timeline
          each item in notifications
            .admin-timeline__item(class=item.type === 'low_sales_warning' ? 'is-warning' : 'is-info')
              .admin-timeline__dot
              .admin-timeline__content
                strong= item.title
                p.mb-1.small= item.message

  each group in [{ title: 'Chờ duyệt', tone: 'is-pending', icon: 'fa-hourglass-half', list: pendingEvents }, { title: 'Bị từ chối', tone: 'is-rejected', icon: 'fa-ban', list: rejectedEvents }, { title: 'Đang diễn ra', tone: 'is-ongoing', icon: 'fa-play-circle', list: ongoingEvents }, { title: 'Sắp diễn ra', tone: 'is-upcoming', icon: 'fa-calendar-check', list: upcomingEvents }, { title: 'Đã kết thúc', tone: 'is-ended', icon: 'fa-flag-checkered', list: endedEvents }]
    .admin-panel.mb-4
      .admin-panel__body
        .admin-section-heading
          div
            h3
              i.fas.me-2(class=group.icon)
              = group.title
            p #{group.list.length} sự kiện trong nhóm này.
        if group.list.length > 0
          .row.g-4
            each ev in group.list
              .col-12.col-md-6.col-xl-4
                .admin-panel.organizer-event-card.h-100
                  .admin-panel__body
                    .d-flex.align-items-start.justify-content-between.gap-3.mb-3
                      .admin-table-entity
                        img.admin-thumb(src=ev.image || '/images/placeholder.jpg' alt=ev.name)
                        .admin-table-entity__meta
                          strong= ev.name
                          small= ev.location || 'Chưa xác định địa điểm'
                      span.admin-status-pill(class=group.tone)= group.title
                    .organizer-event-card__meta
                      span
                        i.fas.fa-calendar-alt.me-2
                        | #{new Date(ev.date).toLocaleDateString('vi-VN')}
                      span
                        i.fas.fa-ticket.me-2
                        | #{calcSoldTickets(ev)}/#{calcTotalTickets(ev)} vé
                    if ev.rejectionReason
                      p.text-danger.small.mb-3 Lý do từ chối: #{ev.rejectionReason}
                    .admin-action-group.mt-3
                      a.btn.admin-table-btn(href=`/events/${ev._id}`)
                        i.fas.fa-eye
                        span Xem công khai
        else
          .admin-empty-state.py-5
            i.fas.fa-calendar-xmark
            h4 Không có sự kiện
            p Không có bản ghi nào trong nhóm #{group.title.toLowerCase()}.
