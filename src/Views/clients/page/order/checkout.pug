extends ../../../layout

block content
  section.py-5.bg-light
    div.container
      div.row.g-4
        div.col-lg-8
          div.card.border-0.shadow-sm.rounded-4
            div.card-body.p-4
              h4.fw-bold.mb-4 Xác nhận đơn hàng
                div.d-flex.gap-3.mb-3
                  img.rounded-3(
                    src=order.eventId.image || '/events/images/placeholder.jpg'
                    width="180"
                    height="120"
                    class="object-fit-cover rounded-3 shadow-sm"
                    alt=order.eventId.name || 'Sự kiện'
                  )
                  div
                    h5.mb-1= order.eventId.name || 'Sự kiện không xác định'
                    p.text-muted.small
                      i.fas.fa-clock.me-1
                      | 15 phút để hoàn tất thanh toán

              hr
              table.table.table-borderless
                thead
                  tr.text-muted.small
                    th LOẠI VÉ
                    th SỐ LƯỢNG
                    th GIÁ
                tbody
                  each item in order.items
                    tr
                      td.fw-bold= item.ticketTypeId.type
                      td x#{item.quantity}
                      td= item.price.toLocaleString('vi-VN') + 'đ'

              div.p-3.bg-warning.bg-opacity-10.border.border-warning.rounded-3.mt-3
                small.text-warning-emphasis
                  i.fas.fa-exclamation-triangle.me-2
                  | Vé của bạn đang được giữ trong
                  span#countdown.ms-1 15:00
                small.d-block.text-muted.mt-2
                  | Nếu rời khỏi trang này trước khi thanh toán, vé sẽ bị hủy và trả lại kho.

        div.col-lg-4
          div.card.border-0.shadow-lg.rounded-4
            div.card-body.p-4
              h5.fw-bold.mb-3 Thanh toán
              div.mb-3
                div.form-check.p-3.border.rounded-3.mb-2
                  input.form-check-input.d-none#momo(type="radio" name="method" value="momo" checked)
                  label.form-check-label.w-100.p-3.border.rounded-3(for="momo")
                    img.ms-2(src="/events/images/momo-logo.png" height="20")
                    div.d-flex.align-items-center
                      div
                        div.fw-bold Ví MoMo
                        small.text-muted Thanh toán qua ví điện tử MoMo

                div.form-check.p-3.border.rounded-3
                  input.form-check-input.d-none#paypal(type="radio" name="method" value="paypal")
                  label.form-check-label.w-100.p-3.border.rounded-3(for="paypal")
                    img.ms-2(src="/events/images/paypal-logo.png" height="20")
                    div.d-flex.align-items-center
                      div
                        div.fw-bold PayPal
                        small.text-muted Thanh toán qua cổng PayPal

                div.form-check.p-3.border.rounded-3
                  input.form-check-input.d-none#vnpay(type="radio" name="method" value="vnpay")
                  label.form-check-label.w-100.p-3.border.rounded-3(for="vnpay")
                    img.ms-2(src="/events/images/vnpay-logo.png" height="20")
                    div.d-flex.align-items-center
                      div
                        div.fw-bold VNPay
                        small.text-muted Thanh toán qua cổng VNPay

              div.d-flex.justify-content-between.mb-4
                span.text-muted Tổng cộng:
                h3.text-primary.fw-bold= order.totalAmount.toLocaleString('vi-VN') + ' VNĐ'

              button.btn.btn-primary.btn-lg.w-100#payNowBtn THANH TOÁN NGAY

block scripts
  script.
    const payNowBtn = document.getElementById('payNowBtn');
    const orderId = !{JSON.stringify(String(order._id))};
    const countdownSeconds = !{JSON.stringify(timeLeft)};
    const abandonEndpoint = `/api/orders/${orderId}/abandon`;
    let allowPageExit = false;
    let abandoningOrder = false;

    const releaseHeldTickets = () => {
      if (allowPageExit || abandoningOrder) return;
      abandoningOrder = true;

      const payload = JSON.stringify({ reason: 'checkout_leave' });

      if (navigator.sendBeacon) {
        const blob = new Blob([payload], { type: 'application/json' });
        navigator.sendBeacon(abandonEndpoint, blob);
        return;
      }

      fetch(abandonEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: payload,
        keepalive: true
      }).catch(() => {});
    };

    function startCountdown(seconds) {
      const display = document.getElementById('countdown');
      let timer = seconds;

      const interval = setInterval(() => {
        const minutes = Math.floor(timer / 60);
        const secondsLeft = timer % 60;
        display.textContent = `${minutes}:${secondsLeft < 10 ? '0' : ''}${secondsLeft}`;

        if (--timer < 0) {
          clearInterval(interval);
          releaseHeldTickets();
          allowPageExit = true;
          alert('Thời gian giữ vé đã hết. Vé đã được trả lại kho.');
          window.location.href = '/events';
        }
      }, 1000);
    }

    startCountdown(countdownSeconds);

    window.addEventListener('beforeunload', (event) => {
      if (allowPageExit) return;
      event.preventDefault();
      event.returnValue = 'Bạn có muốn rời khỏi trang này không? Vé đang giữ sẽ bị hủy và trả lại kho.';
    });

    window.addEventListener('pagehide', () => {
      releaseHeldTickets();
    });

    payNowBtn.addEventListener('click', async () => {
      const selectedMethod = document.querySelector('input[name="method"]:checked');
      if (!selectedMethod) return alert('Vui lòng chọn phương thức thanh toán!');

      const method = selectedMethod.value;

      payNowBtn.disabled = true;
      payNowBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';

      try {
        const res = await fetch('/api/payment/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId, method })
        });

        const data = await res.json();
        if (data.success) {
          allowPageExit = true;
          window.location.href = data.paymentUrl;
        } else {
          alert(data.message || 'Lỗi tạo thanh toán');
          payNowBtn.disabled = false;
          payNowBtn.textContent = 'THANH TOÁN NGAY';
        }
      } catch (err) {
        alert('Lỗi kết nối server');
        payNowBtn.disabled = false;
        payNowBtn.textContent = 'THANH TOÁN NGAY';
      }
    });
